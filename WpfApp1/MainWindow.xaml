<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="889" Width="1291">
    <Window.Resources>
        <Storyboard x:Key="TextBoxAnimation">
            <DoubleAnimation From="0" To="50" Duration="0:0:0.5" Storyboard.TargetProperty="(TextBox.Height)" />
        </Storyboard>
        
    </Window.Resources>

    <Grid>
        <TextBox x:Name="animatedTextBox" Text="Анимированный TextBox" Height="50" VerticalAlignment="Bottom" />
        <Frame Name ="MainFrame" Background="White" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
    
   
  
</Window>
